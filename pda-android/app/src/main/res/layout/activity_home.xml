<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data><variable name="vm" type="com.company.pda.presentation.home.HomeViewModel"/></data>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#EFF6F3">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STORE / OPERATIONS" android:textColor="#124F46" android:textSize="12sp"/>
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Scan order" android:textSize="30sp" android:textStyle="bold" android:textColor="#12352D"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:text="@{vm.status}" android:textSize="15sp" android:textColor="#456259"/>
            <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<androidx.fragment.app.FragmentContainerView android:id="@+id/feature_container" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</layout>
