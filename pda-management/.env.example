# Copy to the workspace root as .env when running Docker Compose.
DATABASE_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=base64-encoded-random-secret-at-least-32-bytes
FCM_ENABLED=false
# Existing databases with V1__retail_schema.sql must use classpath:db/legacy.
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
FINDER_TIMEOUT_SECONDS=60
APP_BOOTSTRAP_ENABLED=false
BOOTSTRAP_PASSWORD=

# Optional sample data: dev only, never runs when prod is also active.
SPRING_PROFILES_ACTIVE=default
APP_SEED_ENABLED=false
SEED_PASSWORD=
