<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.pda.infrastructure.persistence.mybatis.mapper.DeviceMapper">
  <select id="find" resultType="com.company.pda.infrastructure.persistence.mybatis.entity.DeviceEntity">
    SELECT id,device_code,device_name,store_id,credential_hash,fcm_token,last_active_at FROM devices WHERE id=#{id} AND store_id=#{storeId}
  </select>
  <select id="identity" resultType="com.company.pda.infrastructure.persistence.mybatis.entity.DeviceEntity">
    SELECT id,device_code,device_name,store_id,credential_hash,fcm_token,last_active_at FROM devices WHERE id=#{id}
  </select>
  <select id="list" resultType="com.company.pda.infrastructure.persistence.mybatis.entity.DeviceEntity">
    SELECT id,device_code,device_name,store_id,credential_hash,fcm_token,last_active_at FROM devices WHERE store_id=#{storeId} ORDER BY id LIMIT 500
  </select>
  <select id="register" resultType="Long" affectData="true" flushCache="true">
    INSERT INTO devices(device_code,device_name,store_id,registered_by,credential_hash,fcm_token,last_active_at) VALUES(#{code},#{name},#{storeId},#{actorId},#{hash},#{token},now()) RETURNING id
  </select>
  <update id="token">
    UPDATE devices SET fcm_token=#{token},last_active_at=now(),updated_at=now() WHERE id=#{id}
  </update>
  <update id="invalidate">
    UPDATE devices SET fcm_token=NULL,updated_at=now() WHERE id=#{id} AND fcm_token=#{token}
  </update>
</mapper>
