DATABASE_PASSWORD=replace-with-a-long-random-password
# Base64 of at least 32 cryptographically random bytes; no default is provided.
JWT_SECRET=
FCM_ENABLED=false
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
FINDER_TIMEOUT_SECONDS=60
# Enable only for the first installation, then set false and remove the password.
APP_BOOTSTRAP_ENABLED=false
BOOTSTRAP_PASSWORD=

# Optional sample data: set profile dev, enable seed and supply a password.
SPRING_PROFILES_ACTIVE=default
APP_SEED_ENABLED=false
SEED_PASSWORD=
